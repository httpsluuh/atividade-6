#Exercício 16

import math

a = float(input("A: "))

if a == 0:
    print("Não é equação do segundo grau")
else:
    b = float(input("B: "))
    c = float(input("C: "))

    delta = b**2 - 4*a*c

    if delta < 0:
        print("Não possui raízes reais")
    elif delta == 0:
        x = -b / (2*a)
        print("Raiz única:", x)
    else:
        x1 = (-b + math.sqrt(delta)) / (2*a)
        x2 = (-b - math.sqrt(delta)) / (2*a)

        print("x1 =", x1)
        print("x2 =", x2)

